# Copy to .env.docker and fill in before: docker compose --env-file .env.docker up -d --build

# Public URL users open in the browser (no trailing slash). Used for CORS.
# Must match the URL in the browser (scheme + host + port).
# Local Docker default port 8088: http://localhost:8088
# VPS on port 80: https://tournament.example.com
PUBLIC_ORIGIN=http://localhost:8088
HTTP_PORT=8088

MYSQL_ROOT_PASSWORD=change-me-strong-mysql-password
MYSQL_DATABASE=bluestar_tournament

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_BOOTSTRAP_EMAIL=admin@bluestar.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-bootstrap-password
ADMIN_QUICK_PASSWORD=0908

# Optional — registration is informational (no payment required in current flow)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

REGISTRATION_TEST_MIN_SQUAD=false
