DATABASE_URL="jdbc:mysql://localhost:3306/bluestar_tournament?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata"
DATABASE_USERNAME=root
DATABASE_PASSWORD=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads
SLOT_RESERVATION_MINUTES=30
# Set true locally to allow 2-player squads on Register (production should leave unset/false)
REGISTRATION_TEST_MIN_SQUAD=false
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
# Password-only admin entry from site header (set a strong value in production)
ADMIN_QUICK_PASSWORD=
# Test keys from https://dashboard.razorpay.com/app/keys (Test mode toggle → Generate Key)
# Key ID looks like rzp_test_xxxx; secret is shown once at generation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional locally — checkout verify-payment confirms teams without webhooks
RAZORPAY_WEBHOOK_SECRET=
